{
  "name": "updatepilot",
  "version": "3.0.0",
  "description": "Windows desktop update manager with official publisher sources, WinGet integration, and verified installer downloads.",
  "main": "electron/main.js",
  "private": true,
  "author": "Tamer Albayrak",
  "license": "GPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/Taxperia/UpdatePilot.git" },
  "homepage": "https://github.com/Taxperia/UpdatePilot#readme",
  "bugs": { "url": "https://github.com/Taxperia/UpdatePilot/issues" },
  "engines": { "node": ">=22" },
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "start": "node scripts/launch.js",
    "test": "node --test test/*.test.js",
    "diagnose": "node scripts/diagnose.js",
    "qa": "node scripts/launch.js --qa",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": { "sprintf-js": "1.1.4" },
  "build": {
    "appId": "com.updatepilot.desktop",
    "productName": "UpdatePilot",
    "directories": { "output": "dist" },
    "files": ["electron/**/*", "src/**/*", "web/**/*", "assets/**/*", "package.json"],
    "extraFiles": ["LICENSE", "NOTICE", "SECURITY.md"],
    "win": { "target":"portable", "signExecutable":false, "icon":"assets/icon.ico" },
    "portable": { "artifactName": "UpdatePilot-${version}-${arch}.exe" }
  }
}
